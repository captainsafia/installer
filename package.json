{
  "name": "installer",
  "version": "1.0.0",
  "description": "Quickly install pre-compiled binaries from Github releases",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "hurl --test tests/*.hurl",
    "test:record": "RECORD=1 hurl --test tests/*.hurl",
    "test:integration": "./scripts/integration-test.sh",
    "deploy": "wrangler deploy",
    "dev:cf": "wrangler dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "4.11.3",
    "lru-cache": "^11.2.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "5.9.3",
    "wrangler": "^4.54.0"
  }
}
